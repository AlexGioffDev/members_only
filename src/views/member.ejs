<%- include("./partials/header.ejs") %>

    <div class="member-gate">
        <div class="form-card">
            <span class="member-gate__icon">⚜</span>
            <h2 class="form-card__title">Ascend</h2>
            <p class="form-card__subtitle">
                Membership is not purchased.<br>
                It is earned — by those who already know.
            </p>

            <form action="/auth/member" method="POST">
                <div class="field">
                    <label for="secretWord">The secret word</label>
                    <input type="text" name="secretWord" id="secretWord" placeholder="Speak it…" required
                        autocomplete="off">
                </div>
                <button type="submit" class="btn btn--primary">Claim Membership</button>
            </form>
        </div>
    </div>

    <%- include("./partials/footer.ejs") %>