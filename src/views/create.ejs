<%- include('./partials/header.ejs') %>

    <div class="form-card">
        <h2 class="form-card__title">New Dispatch</h2>
        <p class="form-card__subtitle">Your words, preserved for those who belong.</p>

        <form action="/post/create" method="POST">
            <div class="field">
                <label for="title">Title</label>
                <input type="text" name="title" id="title" placeholder="A fitting title…" required>
            </div>
            <div class="field">
                <label for="body">Your message</label>
                <textarea name="body" id="body" placeholder="Write here…" required></textarea>
            </div>
            <button type="submit" class="btn btn--primary">Publish</button>
        </form>
    </div>

    <%- include('./partials/footer.ejs') %>